---
/**
 * 404 — friendly not-found page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="页面未找到" description="您访问的页面不存在。" originalPath="/">
  <div class="page-404">
    <div class="page-404__code" aria-hidden="true">404</div>
    <h1 class="page-404__title">页面未找到</h1>
    <p class="page-404__desc">
      您访问的页面在本镜像站中不存在，可能尚未抓取或路径有误。
    </p>
    <a href="/" class="page-404__link">
      &larr; 返回首页
    </a>
  </div>
</BaseLayout>
