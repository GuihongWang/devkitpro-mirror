---
/**
 * Wiki article — renders a single scraped wiki page.
 *
 * The `[...slug]` catch-all matches any path under /wiki/.
 * Static routes are generated only for entries that exist in the wiki
 * collection; unmatched slugs fall through to the 404 page.
 */
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

type WikiEntry = CollectionEntry<"wiki">;

export async function getStaticPaths() {
  const wikiPages = (await getCollection("wiki")) as WikiEntry[];
  return wikiPages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props as { page: WikiEntry };
// Astro 5 content layer 的渲染 API：render(entry) 基于条目中预渲染的 html 生成 Content
const { Content } = await render(page);

const originalUrl = page.data.original_url;

let originalPath = `/wiki/${page.id}`;
if (originalUrl) {
  try {
    originalPath = new URL(originalUrl).pathname;
  } catch {
    // Keep the local path when original_url is not a valid URL.
  }
}
---

<BaseLayout
  title={page.data.title}
  description={`devkitPro Wiki — ${page.data.title}`}
  originalPath={originalPath}
>
  <article class="wiki-article">
    <header class="page-header">
      <h1>{page.data.title}</h1>
      {originalUrl && (
        <p class="wiki-original">
          原始链接：
          <a href={originalUrl} target="_blank" rel="noopener">
            devkitpro.org
          </a>
        </p>
      )}
    </header>

    <div class="wiki-content">
      <Content />
    </div>
  </article>
</BaseLayout>